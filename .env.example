# Configuration SMTP pour l'envoi direct d'e-mails (sans intermédiaire)
# Pour Gmail, utilisez un "Mot de passe d'application" Google.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=universalpfm@gmail.com
SMTP_PASS=votre_mot_de_passe_d_application_ici

# E-mails de destination
CONTACT_TARGET_EMAIL=universalpfm@gmail.com
CONTACT_CC_EMAILS=universalpfm@gmail.com
